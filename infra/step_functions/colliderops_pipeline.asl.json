{
  "Comment": "ColliderOpsAI Step Functions orchestration for the validated curated_higgs pipeline: request validation, dataset validation, Glue ETL, curated validation, ECS training/evaluation, model registration, model registry validation, and notification.",
  "StartAt": "ValidatePipelineRequest",
  "States": {
    "ValidatePipelineRequest": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "arn:aws:lambda:ap-southeast-2:257212470159:function:colliderOps-ai-validate-pipeline-request",
        "Payload.$": "$"
      },
      "ResultPath": "$.validate_pipeline_request_result",
      "Next": "CheckPipelineRequestValidated",
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "ResultPath": "$.error",
          "Next": "NotifyFailureBeforeValidation"
        }
      ]
    },
    "CheckPipelineRequestValidated": {
      "Type": "Choice",
      "Choices": [
        {
          "Variable": "$.validate_pipeline_request_result.Payload.validated",
          "BooleanEquals": true,
          "Next": "ChooseDatasetMode"
        }
      ],
      "Default": "PipelineRequestValidationFailed"
    },
    "PipelineRequestValidationFailed": {
      "Type": "Pass",
      "Parameters": {
        "error_type": "PipelineRequestValidationError",
        "message.$": "$.validate_pipeline_request_result.Payload.message",
        "lambda_result.$": "$.validate_pipeline_request_result.Payload"
      },
      "ResultPath": "$.error",
      "Next": "NotifyFailureBeforeValidation"
    },
    "ChooseDatasetMode": {
      "Type": "Choice",
      "Choices": [
        {
          "Variable": "$.validate_pipeline_request_result.Payload.dataset_mode",
          "StringEquals": "curated_higgs",
          "Next": "ValidateDatasetMetadata"
        }
      ],
      "Default": "UnsupportedDatasetMode"
    },
    "ValidateDatasetMetadata": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "arn:aws:lambda:ap-southeast-2:257212470159:function:colliderops-ai-validate-dataset-metadata",
        "Payload": {
          "dataset_mode.$": "$.validate_pipeline_request_result.Payload.dataset_mode",
          "run_id.$": "$.validate_pipeline_request_result.Payload.run_id",
          "s3_bucket.$": "$.validate_pipeline_request_result.Payload.s3_bucket",
          "s3_prefix.$": "$.validate_pipeline_request_result.Payload.s3_prefix",
          "total_rows.$": "$.validate_pipeline_request_result.Payload.total_rows"
        }
      },
      "ResultPath": "$.validate_dataset_metadata_result",
      "Next": "CheckDatasetMetadataValidated",
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "ResultPath": "$.error",
          "Next": "NotifyFailure"
        }
      ]
    },
    "CheckDatasetMetadataValidated": {
      "Type": "Choice",
      "Choices": [
        {
          "Variable": "$.validate_dataset_metadata_result.Payload.validated",
          "BooleanEquals": true,
          "Next": "RunCuratedHiggsGlueETL"
        }
      ],
      "Default": "DatasetMetadataValidationFailed"
    },
    "DatasetMetadataValidationFailed": {
      "Type": "Pass",
      "Parameters": {
        "error_type": "DatasetMetadataValidationError",
        "message.$": "$.validate_dataset_metadata_result.Payload.message",
        "lambda_result.$": "$.validate_dataset_metadata_result.Payload"
      },
      "ResultPath": "$.error",
      "Next": "NotifyFailure"
    },
    "RunCuratedHiggsGlueETL": {
      "Type": "Task",
      "Resource": "arn:aws:states:::glue:startJobRun.sync",
      "Parameters": {
        "JobName": "curated_higgs_glue_job",
        "Arguments": {
          "--dataset_mode.$": "$.validate_pipeline_request_result.Payload.dataset_mode",
          "--run_id.$": "$.validate_pipeline_request_result.Payload.run_id",
          "--s3_bucket.$": "$.validate_pipeline_request_result.Payload.s3_bucket",
          "--s3_prefix.$": "$.validate_pipeline_request_result.Payload.s3_prefix",
          "--total_rows.$": "States.Format('{}', $.validate_pipeline_request_result.Payload.total_rows)"
        }
      },
      "ResultPath": "$.etl_result",
      "Next": "ValidateCuratedDataset",
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "ResultPath": "$.error",
          "Next": "NotifyFailure"
        }
      ]
    },
    "ValidateCuratedDataset": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "arn:aws:lambda:ap-southeast-2:257212470159:function:colliderops-ai-validate-curated-dataset",
        "Payload": {
          "dataset_mode.$": "$.validate_pipeline_request_result.Payload.dataset_mode",
          "run_id.$": "$.validate_pipeline_request_result.Payload.run_id",
          "s3_bucket.$": "$.validate_pipeline_request_result.Payload.s3_bucket",
          "s3_prefix.$": "$.validate_pipeline_request_result.Payload.s3_prefix"
        }
      },
      "ResultPath": "$.validate_curated_dataset_result",
      "Next": "CheckCuratedDatasetValidated",
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "ResultPath": "$.error",
          "Next": "NotifyFailure"
        }
      ]
    },
    "CheckCuratedDatasetValidated": {
      "Type": "Choice",
      "Choices": [
        {
          "Variable": "$.validate_curated_dataset_result.Payload.validated",
          "BooleanEquals": true,
          "Next": "RunTrainingEvalTask"
        }
      ],
      "Default": "CuratedDatasetValidationFailed"
    },
    "CuratedDatasetValidationFailed": {
      "Type": "Pass",
      "Parameters": {
        "error_type": "CuratedDatasetValidationError",
        "message.$": "$.validate_curated_dataset_result.Payload.message",
        "lambda_result.$": "$.validate_curated_dataset_result.Payload"
      },
      "ResultPath": "$.error",
      "Next": "NotifyFailure"
    },
    "RunTrainingEvalTask": {
      "Type": "Task",
      "Resource": "arn:aws:states:::ecs:runTask.sync",
      "Parameters": {
        "Cluster": "arn:aws:ecs:ap-southeast-2:257212470159:cluster/colliderops-ai-cluster",
        "TaskDefinition": "arn:aws:ecs:ap-southeast-2:257212470159:task-definition/colliderops-ai-train-eval:1",
        "LaunchType": "FARGATE",
        "NetworkConfiguration": {
          "AwsvpcConfiguration": {
            "Subnets": ["subnet-05e206043907092d7"],
            "SecurityGroups": ["sg-0294871fdd1512d57"],
            "AssignPublicIp": "ENABLED"
          }
        },
        "Overrides": {
          "ContainerOverrides": [
            {
              "Name": "colliderops-ai-train-eval",
              "Environment": [
                {
                  "Name": "COLLIDEROPS_STORAGE_MODE",
                  "Value": "s3"
                },
                {
                  "Name": "COLLIDEROPS_DATASET_MODE",
                  "Value.$": "$.validate_pipeline_request_result.Payload.dataset_mode"
                },
                {
                  "Name": "COLLIDEROPS_RUN_ID",
                  "Value.$": "$.validate_pipeline_request_result.Payload.run_id"
                },
                {
                  "Name": "COLLIDEROPS_S3_BUCKET",
                  "Value.$": "$.validate_pipeline_request_result.Payload.s3_bucket"
                },
                {
                  "Name": "COLLIDEROPS_S3_PREFIX",
                  "Value.$": "$.validate_pipeline_request_result.Payload.s3_prefix"
                },
                {
                  "Name": "AWS_DEFAULT_REGION",
                  "Value": "ap-southeast-2"
                }
              ]
            }
          ]
        }
      },
      "ResultPath": "$.training_eval_result",
      "Next": "RegisterModelMetadata",
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "ResultPath": "$.error",
          "Next": "NotifyFailure"
        }
      ]
    },
    "RegisterModelMetadata": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "arn:aws:lambda:ap-southeast-2:257212470159:function:colliderops-ai-register-model-metadata",
        "Payload": {
          "dataset_mode.$": "$.validate_pipeline_request_result.Payload.dataset_mode",
          "run_id.$": "$.validate_pipeline_request_result.Payload.run_id",
          "s3_bucket.$": "$.validate_pipeline_request_result.Payload.s3_bucket",
          "s3_prefix.$": "$.validate_pipeline_request_result.Payload.s3_prefix"
        }
      },
      "ResultPath": "$.register_model_metadata_result",
      "Next": "CheckModelMetadataRegistered",
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "ResultPath": "$.error",
          "Next": "NotifyFailure"
        }
      ]
    },
    "CheckModelMetadataRegistered": {
      "Type": "Choice",
      "Choices": [
        {
          "Variable": "$.register_model_metadata_result.Payload.registered",
          "BooleanEquals": true,
          "Next": "ValidateModelRegistry"
        }
      ],
      "Default": "ModelMetadataRegistrationFailed"
    },
    "ModelMetadataRegistrationFailed": {
      "Type": "Pass",
      "Parameters": {
        "error_type": "ModelMetadataRegistrationError",
        "message.$": "$.register_model_metadata_result.Payload.message",
        "lambda_result.$": "$.register_model_metadata_result.Payload"
      },
      "ResultPath": "$.error",
      "Next": "NotifyFailure"
    },
    "ValidateModelRegistry": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "arn:aws:lambda:ap-southeast-2:257212470159:function:colliderops-ai-validate-model-registry",
        "Payload": {
          "dataset_mode.$": "$.validate_pipeline_request_result.Payload.dataset_mode",
          "run_id.$": "$.validate_pipeline_request_result.Payload.run_id",
          "s3_bucket.$": "$.validate_pipeline_request_result.Payload.s3_bucket",
          "s3_prefix.$": "$.validate_pipeline_request_result.Payload.s3_prefix"
        }
      },
      "ResultPath": "$.validate_model_registry_result",
      "Next": "CheckModelRegistryValidated",
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "ResultPath": "$.error",
          "Next": "NotifyFailure"
        }
      ]
    },
    "CheckModelRegistryValidated": {
      "Type": "Choice",
      "Choices": [
        {
          "Variable": "$.validate_model_registry_result.Payload.validated",
          "BooleanEquals": true,
          "Next": "NotifySuccess"
        }
      ],
      "Default": "ModelRegistryValidationFailed"
    },
    "ModelRegistryValidationFailed": {
      "Type": "Pass",
      "Parameters": {
        "error_type": "ModelRegistryValidationError",
        "message.$": "$.validate_model_registry_result.Payload.message",
        "lambda_result.$": "$.validate_model_registry_result.Payload"
      },
      "ResultPath": "$.error",
      "Next": "NotifyFailure"
    },
    "NotifySuccess": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "arn:aws:lambda:ap-southeast-2:257212470159:function:colliderOps-ai-notify-pipeline-status",
        "Payload": {
          "status": "success",
          "dataset_mode.$": "$.validate_pipeline_request_result.Payload.dataset_mode",
          "run_id.$": "$.validate_pipeline_request_result.Payload.run_id",
          "s3_bucket.$": "$.validate_pipeline_request_result.Payload.s3_bucket",
          "s3_prefix.$": "$.validate_pipeline_request_result.Payload.s3_prefix"
        }
      },
      "End": true
    },
    "NotifyFailure": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "arn:aws:lambda:ap-southeast-2:257212470159:function:colliderOps-ai-notify-pipeline-status",
        "Payload": {
          "status": "failed",
          "dataset_mode.$": "$.validate_pipeline_request_result.Payload.dataset_mode",
          "run_id.$": "$.validate_pipeline_request_result.Payload.run_id",
          "s3_bucket.$": "$.validate_pipeline_request_result.Payload.s3_bucket",
          "s3_prefix.$": "$.validate_pipeline_request_result.Payload.s3_prefix",
          "error.$": "$.error"
        }
      },
      "End": true
    },
    "NotifyFailureBeforeValidation": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "arn:aws:lambda:ap-southeast-2:257212470159:function:colliderOps-ai-notify-pipeline-status",
        "Payload": {
          "status": "failed",
          "dataset_mode.$": "$.dataset_mode",
          "run_id.$": "States.Format('failed-{}', $$.Execution.Name)",
          "s3_bucket.$": "$.s3_bucket",
          "s3_prefix.$": "$.s3_prefix",
          "error.$": "$.error"
        }
      },
      "End": true
    },
    "UnsupportedDatasetMode": {
      "Type": "Fail",
      "Error": "UnsupportedDatasetMode",
      "Cause": "This first production orchestration supports curated_higgs only. Add real_cern and sample_collider branches after the curated_higgs path is validated end-to-end."
    }
  }
}