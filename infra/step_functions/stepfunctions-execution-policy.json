{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "InvokeColliderOpsLambdas",
      "Effect": "Allow",
      "Action": "lambda:InvokeFunction",
      "Resource": [
        "arn:aws:lambda:ap-southeast-2:257212470159:function:colliderOps-ai-validate-pipeline-request",
        "arn:aws:lambda:ap-southeast-2:257212470159:function:colliderops-ai-validate-dataset-metadata",
        "arn:aws:lambda:ap-southeast-2:257212470159:function:colliderops-ai-validate-curated-dataset",
        "arn:aws:lambda:ap-southeast-2:257212470159:function:colliderops-ai-register-model-metadata",
        "arn:aws:lambda:ap-southeast-2:257212470159:function:colliderops-ai-validate-model-registry",
        "arn:aws:lambda:ap-southeast-2:257212470159:function:colliderOps-ai-notify-pipeline-status"
      ]
    },
    {
      "Sid": "RunGlueJob",
      "Effect": "Allow",
      "Action": [
        "glue:StartJobRun",
        "glue:GetJobRun",
        "glue:GetJobRuns",
        "glue:BatchStopJobRun"
      ],
      "Resource": "arn:aws:glue:ap-southeast-2:257212470159:job/curated_higgs_glue_job"
    },
    {
      "Sid": "RunAndMonitorEcsTask",
      "Effect": "Allow",
      "Action": [
        "ecs:RunTask",
        "ecs:DescribeTasks",
        "ecs:StopTask"
      ],
      "Resource": [
        "arn:aws:ecs:ap-southeast-2:257212470159:task-definition/colliderops-ai-train-eval:1",
        "arn:aws:ecs:ap-southeast-2:257212470159:task/colliderops-ai-cluster/*"
      ]
    },
    {
      "Sid": "PassEcsRoles",
      "Effect": "Allow",
      "Action": "iam:PassRole",
      "Resource": [
        "arn:aws:iam::257212470159:role/colliderops-ai-ecs-task-role",
        "arn:aws:iam::257212470159:role/colliderops-ai-ecs-execution-role",
        "arn:aws:iam::257212470159:role/ecsTaskExecutionRole"
      ]
    },
    {
      "Sid": "AllowStepFunctionsEventsForSyncIntegrations",
      "Effect": "Allow",
      "Action": [
        "events:PutTargets",
        "events:PutRule",
        "events:DescribeRule"
      ],
      "Resource": "arn:aws:events:ap-southeast-2:257212470159:rule/StepFunctionsGetEventsFor*"
    }
  ]
}
