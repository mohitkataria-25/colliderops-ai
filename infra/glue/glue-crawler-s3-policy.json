{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ColliderOpsCrawlerListDevPrefix",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::colliderops-ai-dev-ap-southeast-2",
      "Condition": {
        "StringLike": {
          "s3:prefix": [
            "dev",
            "dev/*"
          ]
        }
      }
    },
    {
      "Sid": "ColliderOpsCrawlerReadDevObjects",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject"
      ],
      "Resource": "arn:aws:s3:::colliderops-ai-dev-ap-southeast-2/dev/*"
    }
  ]
}
