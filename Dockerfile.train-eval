FROM python:3.11-slim

WORKDIR /app

ENV PYTHONUNBUFFERED=1
ENV PIP_NO_CACHE_DIR=1

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

COPY requirements-train-eval.txt /app/requirements-train-eval.txt

RUN pip install --upgrade pip && \
    pip install -r /app/requirements-train-eval.txt

COPY . /app

CMD ["python", "-m", "training.cloud_train_eval"]